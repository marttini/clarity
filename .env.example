# Banco (Supabase: Project Settings > Database > Connection string, modo "Transaction pooler")
DATABASE_URL=postgres://postgres@localhost:5432/clarity

# Login. "dev" = escolher a pessoa numa lista (só local!). "supabase" = Google do time + link mágico dos clientes.
AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Domínio de e-mail do time (login Google restrito)
TEAM_EMAIL_DOMAIN=sintesebrasil.com

# Odoo (JSON-2). Chave do usuário "Integração Clarity". Nunca no navegador.
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
# "fake" usa o Odoo de mentira dos testes; "real" usa ODOO_URL.
ODOO_MODE=fake

# Avisos
SLACK_BOT_TOKEN=
SLACK_GESTAO_CHANNEL=#clarity-gestao
SLACK_GUARDIAO_USER_ID=
RESEND_API_KEY=
EMAIL_FROM="Síntese Clarity <clarity@sintesebrasil.com>"
# "dry-run" só registra; "live" envia de verdade.
NOTIFY_MODE=dry-run

# Rotinas agendadas (Vercel Cron manda este segredo)
CRON_SECRET=

APP_URL=http://localhost:3000
